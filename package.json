{
  "name": "lingostep",
  "version": "6.1.0",
  "description": "LingoStep — listen, type, and master English step by step. Zero-dependency static PWA (plain HTML/CSS/JS ES modules) deployed on GitHub Pages.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/serve.js",
    "test": "node tests/run-all.js",
